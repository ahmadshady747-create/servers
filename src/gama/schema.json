        "properties": {
          "angleRad": {
            "description": "Rotation angle in radians (default: 1.5707)",
            "type": "number"
          },
          "dim": {
            "description": "Dimension N (default: 6)",
            "type": "number"
          },
          "planeI": {
            "description": "First axis index i (default: 0)",
            "type": "number"
          },
          "planeJ": {
            "description": "Second axis index j (default: 5)",
            "type": "number"
          },
          "vector": {
            "description": "Input N-dimensional vector components",
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "gama_cosserat_step",
