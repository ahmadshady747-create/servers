{
  "server": "gama-mcp-server",
  "version": "1.0.0",
  "tools": [
    {
      "name": "forge_apply_csg",
      "description": "Applies exact polyhedral boundary CSG operations (Union, Subtract, Intersect) directly on active polygonal meshes.",
      "parameters": {
        "properties": {
          "meshAId": {
            "description": "Identifier of mesh A",
            "type": "string"
          },
          "meshBId": {
            "description": "Identifier of mesh B",
            "type": "string"
          },
          "operation": {
            "description": "CSG boolean operation to perform",
            "enum": [
              "union",
              "subtract",
              "intersect"
            ],
            "type": "string"
          },
          "resultMeshId": {
            "description": "Identifier for output mesh",
            "type": "string"
          }
        },
        "required": [
          "meshAId",
          "meshBId",
          "resultMeshId",
          "operation"
        ],
        "type": "object"
      }
    },
    {
      "name": "forge_apply_operator",
      "description": "Applies boolean CSG (Union, Diff, Intersect), smooth blending (smin), or domain warps (twist, bend, shell, round) to SDF nodes.",
      "parameters": {
        "properties": {
          "id": {
            "description": "Unique identifier for resulting composite SDF node",
            "type": "string"
          },
          "operator": {
            "description": "Operation to apply",
            "enum": [
              "union",
              "difference",
              "intersection",
              "smooth_union",
              "smooth_difference",
              "smooth_intersection",
              "twist",
              "bend",
              "shell",
              "round"
            ],
            "type": "string"
          },
          "param": {
            "description": "Smooth blend radius or warp rate parameter (default: 0.2)",
            "type": "number"
          },
          "targetA": {
            "description": "Identifier of operand A",
            "type": "string"
          },
          "targetB": {
            "description": "Identifier of operand B (required for binary operations)",
            "type": "string"
          }
        },
        "required": [
          "id",
          "operator",
          "targetA"
        ],
        "type": "object"
      }
    },
    {
      "name": "forge_create_sdf_primitive",
      "description": "Creates a 3D Signed Distance Field primitive (Sphere, Box, Cylinder, Torus, Gyroid, Capsule) in the active Forge session.",
      "parameters": {
        "properties": {
          "dimensions": {
            "description": "Dimensions: [radius] for sphere, [hx, hy, hz] for box, [r, h] for cylinder, [R, r] for torus",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "id": {
            "description": "Unique identifier for the SDF primitive node",
            "type": "string"
          },
          "transform": {
            "properties": {
              "posX": {
                "type": "number"
              },
              "posY": {
                "type": "number"
              },
              "posZ": {
                "type": "number"
              },
              "scaleX": {
                "type": "number"
              },
              "scaleY": {
                "type": "number"
              },
              "scaleZ": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "type": {
            "description": "Mathematical primitive volume type",
            "enum": [
              "sphere",
              "box",
              "cylinder",
              "torus",
              "gyroid",
              "capsule"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      }
    },
    {
      "name": "forge_export_asset",
      "description": "Exports geometry to a binary glTF 2.0 (.glb) asset or integrates it directly into GAMA physics body colliders.",
      "parameters": {
        "properties": {
          "density": {
            "description": "Material density in kg per m^3 (default: 1000)",
            "type": "number"
          },
          "format": {
            "description": "Export format: glb (base64 binary) or gama_body (physics collider representation)",
            "enum": [
              "glb",
              "gama_body"
            ],
            "type": "string"
          },
          "isStatic": {
            "description": "Whether body is static in physics world",
            "type": "boolean"
          },
          "meshId": {
            "description": "Identifier of mesh to export",
            "type": "string"
          }
        },
        "required": [
          "meshId"
        ],
        "type": "object"
      }
    },
    {
      "name": "forge_extract_mesh",
      "description": "Extracts a watertight 3D polygonal mesh from an active SDF tree using the Marching Cubes polygonizer.",
      "parameters": {
        "properties": {
          "boundsMax": {
            "description": "[maxX, maxY, maxZ]",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "boundsMin": {
            "description": "[minX, minY, minZ]",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "isoLevel": {
            "description": "Isosurface threshold value (default: 0.0)",
            "type": "number"
          },
          "meshId": {
            "description": "Identifier to store generated mesh under",
            "type": "string"
          },
          "resolution": {
            "description": "Voxel grid resolution (default: 24, range: 8..48)",
            "type": "number"
          },
          "targetSdfId": {
            "description": "Identifier of SDF to polygonize",
            "type": "string"
          }
        },
        "required": [
          "targetSdfId",
          "meshId"
        ],
        "type": "object"
      }
    },
    {
      "name": "forge_validate_manifold",
